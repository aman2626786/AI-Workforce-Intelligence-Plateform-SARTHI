# =============================================================================
# SKILLVANTAGE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your actual API keys. Never commit .env to Git!
# =============================================================================

# Server Settings
PROJECT_NAME="SkillVantage AI Backend"
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key"
API_V1_STR="/api"

# Database Configuration (PostgreSQL on Render, SQLite locally)
# DATABASE_URL="postgresql://user:password@hostname:5432/dbname"
DATABASE_URL="sqlite:///./backend/skillvantage.db"

# Frontend & CORS Settings (for Backend)
FRONTEND_URL="http://localhost:3000"
ALLOW_ALL_CORS="true"

# -----------------------------------------------------------------------------
# NEXT.JS FRONTEND ENVIRONMENT VARIABLES (Client side)
# -----------------------------------------------------------------------------
# Backend API URL (Use your Render Backend URL in production: https://your-backend.onrender.com/api)
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Firebase Client Configuration (From Firebase Console -> Project Settings -> General -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="skillvantage-ai.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="skillvantage-ai"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="skillvantage-ai.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# -----------------------------------------------------------------------------
# 1. ADZUNA API CREDENTIALS (https://developer.adzuna.com/)
# -----------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# -----------------------------------------------------------------------------
# 2. JOOBLE API CREDENTIALS (https://jooble.org/api/about)
# Note: Provide regional keys if using country-specific subscriptions
# -----------------------------------------------------------------------------
JOOBLE_API_KEY=
JOOBLE_IN_API_KEY=
JOOBLE_US_API_KEY=
JOOBLE_UK_API_KEY=

# -----------------------------------------------------------------------------
# 3. USAJOBS API CREDENTIALS (https://developer.usajobs.gov/)
# -----------------------------------------------------------------------------
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# -----------------------------------------------------------------------------
# 4. JOB COLLECTION AGENT SCHEDULER & CONCURRENCY
# -----------------------------------------------------------------------------
JOB_COLLECTION_CRON="0 2 * * *"
JOB_COLLECTION_DEFAULT_PAGE_SIZE=20
JOB_COLLECTION_MAX_PAGES_PER_RUN=3
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=15

