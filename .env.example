# =============================================================================
# SKILLVANTAGE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your actual API keys. Never commit .env to Git!
# =============================================================================

# Server Settings
PROJECT_NAME="SkillVantage AI Backend"
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key"
API_V1_STR="/api"

# Database Configuration (PostgreSQL in production, SQLite locally)
# DATABASE_URL="postgresql://user:password@localhost:5432/skillvantage"
DATABASE_URL="sqlite:///./backend/skillvantage.db"

# -----------------------------------------------------------------------------
# 1. ADZUNA API CREDENTIALS (https://developer.adzuna.com/)
# -----------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# -----------------------------------------------------------------------------
# 2. JOOBLE API CREDENTIALS (https://jooble.org/api/about)
# Note: Provide regional keys if using country-specific subscriptions
# -----------------------------------------------------------------------------
JOOBLE_API_KEY=
JOOBLE_IN_API_KEY=
JOOBLE_US_API_KEY=
JOOBLE_UK_API_KEY=

# -----------------------------------------------------------------------------
# 3. USAJOBS API CREDENTIALS (https://developer.usajobs.gov/)
# -----------------------------------------------------------------------------
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# -----------------------------------------------------------------------------
# 4. JOB COLLECTION AGENT SCHEDULER & CONCURRENCY
# -----------------------------------------------------------------------------
JOB_COLLECTION_CRON="0 2 * * *"
JOB_COLLECTION_DEFAULT_PAGE_SIZE=20
JOB_COLLECTION_MAX_PAGES_PER_RUN=3
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=15
